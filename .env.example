# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Kakao developers -> REST API key. Server only.
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# Origin sent in Kakao's required KA header. MUST be registered in the Kakao
# console under 앱 설정 > 플랫폼 > Web > 사이트 도메인, or every call 401s with
# "domain mismatched!". Defaults to http://localhost:3000.
KAKAO_ORIGIN=http://localhost:3000
